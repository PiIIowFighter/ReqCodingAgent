{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "results"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "invalid"]},
    "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["instance_id", "mode", "status", "result"], "properties": {"instance_id": {"type": "string"}, "mode": {"enum": ["noop", "gold"]}, "status": {"enum": ["passed", "test_failed", "infra_failed", "timeout", "invalid"]}, "result": {"type": "string"}}}}
  }
}
