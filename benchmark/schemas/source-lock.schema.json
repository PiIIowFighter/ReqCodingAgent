{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["harness", "verified", "lite"],
      "properties": {
        "harness": {"$ref": "#/$defs/source"}, "verified": {"$ref": "#/$defs/source"}, "lite": {"$ref": "#/$defs/source"}
      }
    }
  },
  "$defs": {"source": {"type": "object", "additionalProperties": false, "required": ["url", "revision"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}
}
