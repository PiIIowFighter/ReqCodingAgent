{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_fingerprint", "result", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "result.json"},
    "artifacts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
