{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "checks", "source_heads", "inputs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "passed"},
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_pairs_12_3", "distribution_4_4_4_1_1_1", "official_hashes_15", "pair_official_fields_equal"],
      "properties": {
        "schema_pairs_12_3": {"const": true}, "distribution_4_4_4_1_1_1": {"const": true},
        "official_hashes_15": {"const": true}, "pair_official_fields_equal": {"const": true}
      }
    },
    "source_heads": {
      "type": "object", "additionalProperties": false, "required": ["harness", "verified", "lite"],
      "properties": {"harness": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "verified": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "lite": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "inputs": {
      "type": "object", "additionalProperties": false, "required": ["public_manifest_sha256", "oracle_manifest_sha256"],
      "properties": {"public_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "oracle_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
