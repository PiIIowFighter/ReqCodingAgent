{
  "mode": "scripted",
  "model": {
    "provider": "scripted",
    "base_url_env": "REQAGENT_BASE_URL",
    "api_key_env": "REQAGENT_API_KEY",
    "model": "scripted-offline",
    "protocol": "internal-script-v1",
    "native_tool_calling": false,
    "context_window_tokens": 32768,
    "max_output_tokens": 4096,
    "temperature": null,
    "seed": 0
  },
  "budgets": {
    "max_steps": 30,
    "max_tool_calls": 60,
    "wall_clock_seconds": 1800,
    "model_timeout_seconds": 180,
    "command_timeout_seconds": 300,
    "max_invalid_outputs": 6,
    "max_retries": 3,
    "context_trigger_ratio": 0.8,
    "keep_recent_rounds": 2
  },
  "workspace": {
    "max_patch_files": 5,
    "max_patch_lines": 500,
    "max_patch_bytes": 131072,
    "protected_paths": []
  },
  "script": [
    {
      "text": "Inspect repository files.",
      "tool_calls": [{"call_id": "call-1", "name": "list_files", "arguments": {"path": ".", "depth": 2}}],
      "usage": {"input_tokens": 1, "output_tokens": 1},
      "finish_reason": "tool_calls",
      "provider_request_id": "script-1"
    },
    {
      "text": "No generic edit can be scripted for an arbitrary repository.",
      "tool_calls": [{"call_id": "call-2", "name": "submit", "arguments": {"summary": "Inspected the repository; no repository-specific scripted edit was configured.", "tests": [], "limitations": "Offline template only."}}],
      "usage": {"input_tokens": 1, "output_tokens": 1},
      "finish_reason": "tool_calls",
      "provider_request_id": "script-2"
    }
  ]
}
